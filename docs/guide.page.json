            },
            {
              "label": "📄 markdown.py",
              "href": "https://github.com/myon-bioinformatics/markdown/blob/main/markdown.py"
            },
            {
              "label": "🩺 診断",
              "href": "./repository-diagnostics.html"
            },
            {
              "label": "📊 ベンチマーク（README）",
              "href": "https://github.com/myon-bioinformatics/markdown#benchmark-how-far-does-this-get-on-real-markdown"
            }
          ]
        }
      ]
    }
  ]
}
